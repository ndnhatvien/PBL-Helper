{
  "name": "pbl-grading-review",
  "private": true,
  "version": "1.0.0",
  "description": "MVP quản lý chấm và rà soát điểm PBL (local-first)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:ui": "npm run build && node scripts/e2e-ui.mjs",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
